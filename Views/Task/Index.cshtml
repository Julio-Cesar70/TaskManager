@model IEnumerable<TaskManager.Models.Task>

@{
    ViewData["Title"] = "Minhas Tarefas";
}

@section Styles {
    <link rel="stylesheet" href="~/css/tasks.css" />
}

<div class="task-container">
    <h1 class="title">Tarefas</h1>

    <form asp-controller="Task" asp-action="Index" method="get" class="form-task">
        <div class="form-group">
            <label class="label-task" for="SearchString">
                Nome da Tarefa:
            </label>

            <input type="text" 
                   id="SearchString" 
                   name="SearchString" 
                   value="@Context.Request.Query["SearchString"]"
                   placeholder="Digite o nome da tarefa..."/>

            <button type="submit" class="btn-primary">
                Filtrar
            </button>
        </div>
    </form>


        @if (!Model.Any())
    {
        <div class="alert alert-warning text-center">
            <strong>Nenhuma tarefa encontrada!</strong>
            <p>Não encontramos nenhuma tarefa com esse nome.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Nome da tarefa</th>
                        <th>Descrição</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>

                <tbody class="table tbody td">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.Description)</td>
                            <td class="text-center">
                                <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">Excluir</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        <p>
            <a asp-action="Create" class="btn-primary">Adicionar Tarefa</a>
        </p>
</div>