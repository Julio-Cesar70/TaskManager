@model TaskManager.Models.Task

@{
    ViewData["Title"] = "Detalhes da Tarefa";
}

<h1 class="title">Detalhes da Tarefa</h1>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
